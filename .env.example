# Hardhat reads the shell environment, not this file. Export these (or prefix a command
# with them); never put a real key in a file inside this repository.

# JSON-RPC URL of a Sepolia node (e.g. from Alchemy or Infura).
SEPOLIA_RPC_URL=
# PRIVATE_KEY (a throwaway Sepolia deployer's key, 0x-prefixed) is not listed here: export
# it in your shell only (see guides/sepolia-deployment.md, step 2), never in a file.
# The WETH contract to wrap for TOKEN_KIND=wrapped (Sepolia WETH shown).
WETH_ADDRESS=0xfFf9976782d46CC05630D1f6eBAb18b2324d6B14
# Leave empty. Pass CONFIRM_DEPLOY=sepolia on the command line for each deploy, so that
# sourcing this file never pre-confirms anything.
CONFIRM_DEPLOY=
